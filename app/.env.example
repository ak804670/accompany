# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Public client configuration. Do not put secrets here.
# Same PC: http://localhost:4000
# Android emulator: http://10.0.2.2:4000
# Physical phone (Expo Go): http://<this-PC-LAN-IP>:4000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
EXPO_PUBLIC_WS_BASE_URL=wss://ws.example.com
EXPO_PUBLIC_PROFILE_IMAGE_MAX_WIDTH=2048
EXPO_PUBLIC_PROFILE_IMAGE_MAX_HEIGHT=2048
EXPO_PUBLIC_PROFILE_IMAGE_MAX_SIZE_BYTES=2097152
EXPO_PUBLIC_PROFILE_IMAGE_INITIAL_QUALITY=0.90
EXPO_PUBLIC_PROFILE_IMAGE_MIN_QUALITY=0.70
EXPO_PUBLIC_MAX_PROFILE_PHOTOS=10
# GIPHY SDK keys are client keys embedded in the corresponding native app.
EXPO_PUBLIC_GIPHY_ANDROID_SDK_KEY=
EXPO_PUBLIC_GIPHY_IOS_SDK_KEY=
