{
  "expo": {
    "name": "Accompany",
    "slug": "accompany",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "accompany",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.accompany.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Accompany uses your microphone for voice and video calls.",
        "NSCameraUsageDescription": "Accompany uses your camera for video calls.",
        "UIBackgroundModes": [
          "voip",
          "audio"
        ]
      },
      "bitcode": false
    },
    "android": {
      "package": "com.accompany.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F4EF"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EF"
        }
      ],
      "expo-font",
      "./plugins/withLiveKitMainApplication",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-secure-store",
      "@giphy/react-native-sdk",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Accompany uses your location to show people nearby. Other people only see an approximate distance."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F7F4EF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "beccc0d3-3115-44e5-a605-ed889a880cf1"
      }
    }
  }
}
