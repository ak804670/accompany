<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

  <application>
    <service
      android:name="expo.modules.accompanycalls.CallForegroundService"
      android:exported="false"
      android:foregroundServiceType="phoneCall" />
    <service
      android:name="expo.modules.accompanycalls.AccompanyConnectionService"
      android:exported="true"
      android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
      <intent-filter>
        <action android:name="android.telecom.ConnectionService" />
      </intent-filter>
    </service>
    <receiver android:name="expo.modules.accompanycalls.CallActionReceiver" android:exported="false" />
  </application>
</manifest>
